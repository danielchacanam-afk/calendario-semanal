// Private calendar document: users/{uid}/state/calendar
// Required: payload (JSON string <= 450000 chars), revision (positive int),
// updatedAt (server timestamp). Owner is determined by the authenticated UID path.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function validCalendar(data) {
      return data.keys().hasAll(['payload','revision','updatedAt'])
        && data.keys().hasOnly(['payload','revision','updatedAt'])
        && data.payload is string && data.payload.size() <= 450000
        && data.revision is int && data.revision > 0 && data.revision < 2147483647
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid}/state/calendar {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validCalendar(request.resource.data)
        && request.resource.data.revision == 1;
      allow update: if isOwner(uid) && validCalendar(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
  }
}

